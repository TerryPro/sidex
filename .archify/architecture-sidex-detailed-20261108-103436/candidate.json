  "cards": [
    {
      "dot": "cyan",
      "title": "文件管理主链路",
      "items": [
        "每个目录标签独立维护导航历史、文件列表视图与编辑器工作集",
        "文件列表虚拟滚动，只渲染可视行并保留滚动位置",
        "排序、列宽、过滤与递归名称搜索都作用于完整数据集",
        "右键支持新建、重命名、复制粘贴、回收站删除，最近 20 步可撤销"
      ]
    },
    {
      "dot": "emerald",
      "title": "编辑与预览",
      "items": [
        "Monaco 提供多光标、查找替换、折叠与自动保存",
        "CSV 使用原生表格 EditorPane，编辑后直接写回文件",
        "PDF、HTML、Markdown、Mermaid、图片均为原生 EditorPane",
        "PDF 与 Mermaid 内核按需动态加载；Markdown 渲染统一走 markdownHtml"
      ]
    },
    {
      "dot": "violet",
      "title": "Rust 能力层",
      "items": [
        "sidex-workspace 负责文件树、文件操作与名称/全文搜索",
        "sidex-syntax 用 tree-sitter 解析 TypeScript 大纲，其余语言回退正则",
        "sidex-textmate 提供 TextMate 分词；sidex-theme 提供主题解析",
        "sidex-settings / keymap 与 sidex-profiles / auth 承担配置、键位、档案与凭据",
        "notify 做目录监视，portable-pty 提供终端，rusqlite 负责状态库"
      ]
    },
    {
      "dot": "rose",
      "title": "边界与已移除能力",
      "items": [
        "没有 Node / WASM 扩展运行时，扩展只保留声明式目录与只读面板",
        "没有 LSP、Git、Problems、调试、任务与笔记本",
        "没有扩展市场、账号同步、遥测与自动更新",
        "单窗口、自绘菜单；sidex-asset 协议只读本地资源"
      ]
    }
  ]
}
