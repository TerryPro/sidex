  "cards": [
    {
      "dot": "rose",
      "title": "现状：四处断点",
      "items": [
        "customEditor 模块只剩 4 个桩文件",
        "registerCustomEditorProvider 只打一行日志",
        "sidex.toml 只解析 languages 与 commands",
        "WIT host-api 没有编辑器注册与 webview 创建函数"
      ]
    },
    {
      "dot": "amber",
      "title": "隔离边界",
      "items": [
        "每个 webview 一个 iframe + Service Worker + MessagePort",
        "WebView2 跨源 iframe 是否分进程取决于站点隔离策略，不保证",
        "隔离加固需要实测，不能默认成立"
      ]
    },
    {
      "dot": "cyan",
      "title": "实施顺序",
      "items": [
        "A 核心服务 → B 输入与面板 → C Node 桥接打通",
        "D 清单与 WIT 契约 → E WASM 推送通道 → F 隔离加固与度量",
        "A 到 C 是地基，D 到 E 才谈得上第三方扩展"
      ]
    }
  ]
