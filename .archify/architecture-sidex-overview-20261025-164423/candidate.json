  "cards": [
    {
      "dot": "cyan",
      "title": "界面层 · Tauri Webview",
      "items": [
        "Workbench 直接移植 VSCode 的布局、命令与状态栏",
        "Monaco + textmate WASM 负责语法高亮与补全",
        "终端面板基于 xterm.js，PTY 由 Rust 提供",
        "Chat 面板承载对话、内联 diff 与工具确认"
      ]
    },
    {
      "dot": "emerald",
      "title": "本机系统能力 · Rust",
      "items": [
        "fs / search / notify：文件读写、全文检索、文件监听",
        "Git 命令覆盖 status、diff、log、commit、push、stash",
        "rusqlite 保存设置、会话与编辑历史",
        "子进程管理 LSP 语言服务与 DAP 调试适配器",
        "扩展平台从 Open VSX 安装扩展"
      ]
    },
    {
      "dot": "violet",
      "title": "AI 子系统 · 全本机",
      "items": [
        "Rust 启动时 spawn sidex-server 并监督重启（server.rs）",
        "凭据只经进程环境注入，不落配置文件、不下发 webview",
        "sidex-agent 执行读写文件、命令、git、搜索工具",
        "sidex-context 负责分块、嵌入、BM25 与上下文组装",
        "MCP 客户端、hooks、会话与记忆都在 sidex-server 内"
      ]
    },
    {
      "dot": "amber",
      "title": "跨层支撑",
      "items": [
        "前端统一走 invoke() / 事件，命令注册于 lib.rs",
        "独立 worker：editorWorker、textMateWorker、extensionHostWorker",
        "WASM 扩展与远程开发走独立通道",
        "无账号、无托管后端；服务只绑定回环地址"
      ]
    }
  ]
}
