    {
      "dot": "cyan",
      "title": "界面层 · Tauri Webview",
      "items": [
        "Workbench 直接移植 VSCode 的布局、命令与状态栏",
        "Monaco + textmate WASM 负责语法高亮与补全",
        "终端面板基于 xterm.js，PTY 由 Rust 提供",
        "远程资源管理器统一管理 SSH、WSL 与容器"
      ]
    },
    {
      "dot": "emerald",
      "title": "本机系统能力 · Rust",
      "items": [
        "fs / search / notify：文件读写、全文检索、文件监听",
        "Git 命令覆盖 status、diff、log、commit、push、stash",
        "rusqlite 保存设置、会话与编辑历史",
        "子进程管理 LSP 语言服务，终端走 portable-pty",
        "19 个 crate 支撑 textmate、keymap、theme、settings"
      ]
    },
    {
      "dot": "violet",
      "title": "扩展体系 · 双运行时",
      "items": [
        "扩展平台从 Open VSX 安装 VSIX 并校验清单",
        "Node 扩展宿主以 sidecar 运行 server.cjs / host.cjs",
        "host.cjs 手写 vscode API 垫片，经 WebSocket 与 workbench 通信",
        "wasmtime 组件模型运行 WASM 扩展，走独立 WIT 接口"
      ]
    },
    {
      "dot": "amber",
      "title": "已移除的子系统",
      "items": [
        "AI Agent：sidexChat 面板、sidex-agent / sidex-context、Go sidex-server",
        "调试：DAP 客户端、调试 UI、断点与调试控制台",
        "测试：Test Explorer、测试扩展 API 与结果面板",
        "任务系统：tasks 面板、npm/cargo/make 发现与问题匹配"
      ]
    }
