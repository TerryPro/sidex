  "cards": [
    {
      "dot": "cyan",
      "title": "文件管理主链路",
      "items": [
        "目录标签各自维护导航历史、文件列表视图和编辑器工作集",
        "文件列表支持排序列、列宽持久化与分页加载",
        "单击文件显示预览与属性，双击在主编辑区打开",
        "右键菜单接入新建、重命名、回收站删除、复制与粘贴"
      ]
    },
    {
      "dot": "emerald",
      "title": "编辑与预览",
      "items": [
        "Monaco 编辑器保留多光标、查找替换、折叠与自动保存",
        "CSV 使用原生表格编辑器，不再依赖 WASM 扩展",
        "图片、PDF、HTML、Markdown、Mermaid 均以原生 EditorPane 预览",
        "高亮由 TextMate 语法提供；大纲与折叠由 Rust 原生实现"
      ]
    },
    {
      "dot": "violet",
      "title": "Rust 能力 crates",
      "items": [
        "sidex-workspace：文件树、搜索、路径与文件操作",
        "sidex-text：Rope 文本缓冲、编码与行处理",
        "sidex-syntax：语言检测、高亮、大纲与折叠",
        "sidex-textmate：TextMate 分词与语法栈",
        "sidex-terminal：PTY、终端网格与 ANSI 模拟",
        "sidex-settings / keymap / theme：配置、键位与主题",
        "sidex-db / profiles / auth：SQLite、档案与密钥",
        "sidex-extensions：声明式扩展清单与路径"
      ]
    },
    {
      "dot": "rose",
      "title": "已移除的能力",
      "items": [
        "Node 扩展宿主、WASM 扩展运行时与自定义编辑器宿主",
        "扩展市场、下载与 Open VSX 客户端",
        "Git、源代码管理与时间线",
        "LSP 语言服务器与语言诊断",
        "账号同步、遥测与自动更新"
      ]
    }
  ]
}